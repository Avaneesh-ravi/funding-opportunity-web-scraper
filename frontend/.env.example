# Frontend Vite Configuration (Vercel / Production)

# URL pointing to your deployed FastAPI backend on Render
# Do not include a trailing slash.
# Example:
VITE_API_BASE_URL="https://your-backend.onrender.com"

# In local development, leave this variable unset or empty to use
# the local Vite dev proxy (/api -> http://127.0.0.1:8000).

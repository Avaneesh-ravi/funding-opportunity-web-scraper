# ==============================================================================
# Web Scraping Dashboard & Funding Opportunity Tracker — Environment Variables
# ==============================================================================

# --- Backend Environment Variables (Render) -----------------------------------
PROJECT_NAME="Web Scraping Dashboard — BRNS Funding Opportunity Tracker"
DEBUG=false

# Database connection:
# Local SQLite default:
DATABASE_URL="sqlite:///./data/dashboard.db"
# Render Persistent Disk (mount path /opt/render/project/data):
# DATABASE_URL="sqlite:////opt/render/project/data/dashboard.db"
# Render Managed PostgreSQL:
# DATABASE_URL="postgresql://username:password@hostname:5432/dbname"

# Allowed CORS origins (comma-separated string, NO WILDCARD in production):
CORS_ORIGINS_STR="https://your-frontend.vercel.app,http://localhost:5173,http://127.0.0.1:5173"

TIMEZONE="Asia/Kolkata"
SCRAPER_TIMEOUT=30
DEFAULT_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# --- Frontend Environment Variables (Vercel) ----------------------------------
# URL pointing to the deployed FastAPI backend on Render (no trailing slash):
VITE_API_BASE_URL="https://your-backend.onrender.com"
